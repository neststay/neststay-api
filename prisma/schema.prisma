generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              BigInt    @id @default(autoincrement())
  slug            String    @unique
  name            String?
  email           String    @unique
  password        String
  lastLoggedIn    DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  properties          Property[]
  favouriteProperties FavouriteProperty[]

  @@map("users")
}

model Location {
  id        BigInt   @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("locations")
}

model PlaceType {
  id        BigInt   @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("place_types")
}

model Property {
  id                BigInt   @id @default(autoincrement())
  slug              String   @unique
  hostId            BigInt
  locationId        BigInt
  placeTypeId       BigInt
  nightlyRate       Decimal  @db.Decimal(10, 2)
  name              String
  description       String
  numberOfGuests    Int
  numberOfBedrooms  Int
  numberOfBathrooms Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  host                User                @relation(fields: [hostId], references: [id])
  location            Location            @relation(fields: [locationId], references: [id])
  placeType           PlaceType           @relation(fields: [placeTypeId], references: [id])
  images              Image[]
  favouriteProperties FavouriteProperty[]

  @@map("properties")
}

model Image {
  id         BigInt   @id @default(autoincrement())
  propertyId BigInt
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("images")
}

model FavouriteProperty {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  propertyId BigInt
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favourite_property")
}
