generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              BigInt    @id @default(autoincrement())
  slug            String    @unique
  name            String?
  email           String    @unique
  password        String
  lastLoggedIn    DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  properties          Property[]
  favouriteProperties FavouriteProperty[]
  bookings            Booking[]

  @@map("users")
}

model Location {
  id        BigInt   @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("locations")
}

model PlaceType {
  id        BigInt   @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("place_types")
}

model Property {
  id                BigInt   @id @default(autoincrement())
  slug              String   @unique
  hostId            BigInt
  locationId        BigInt
  placeTypeId       BigInt
  nightlyRate       Decimal  @db.Decimal(10, 2)
  name              String
  description       String
  numberOfGuests    Int
  numberOfBedrooms  Int
  numberOfBathrooms Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  host                User                     @relation(fields: [hostId], references: [id])
  location            Location                 @relation(fields: [locationId], references: [id])
  placeType           PlaceType                @relation(fields: [placeTypeId], references: [id])
  images              Image[]
  favouriteProperties FavouriteProperty[]
  bookings            Booking[]
  unavailability      PropertyUnavailability[]

  @@map("properties")
}

model Image {
  id         BigInt   @id @default(autoincrement())
  propertyId BigInt
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("images")
}

model FavouriteProperty {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  propertyId BigInt
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favourite_property")
}

model SearchHistory {
  id        BigInt   @id @default(autoincrement())
  searchId  String   @unique
  userId    BigInt?
  query     String
  createdAt DateTime @default(now())

  @@map("search_history")
}

model Booking {
  id            BigInt   @id @default(autoincrement())
  slug          String   @unique
  guestId       BigInt
  propertyId    BigInt
  checkInDate   DateTime @db.Date
  checkOutDate  DateTime @db.Date
  nightlyRate   Decimal  @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)
  paymentStatus String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guest                  User                    @relation(fields: [guestId], references: [id])
  property               Property                @relation(fields: [propertyId], references: [id])
  propertyUnavailability PropertyUnavailability?

  @@map("bookings")
}

/// The unique (propertyId, daterange(startDate, endDate, '[)')) exclusion is enforced by a
/// hand-written Postgres GiST constraint in this table's migration (requires btree_gist) —
/// it has no representation in this Prisma schema, so verify it still exists after any
/// future migration touching this table.
model PropertyUnavailability {
  id         BigInt   @id @default(autoincrement())
  propertyId BigInt
  bookingId  BigInt?  @unique
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  source     String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@map("property_unavailability")
}
