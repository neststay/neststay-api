# Application
APP_ENV=development
APP_PORT=3000
APP_DEBUG=false

# Database URL — matches the `db` service in docker-compose.yml
DATABASE_URL=postgresql://postgres:password@localhost:5433/rynok

# Postgres (docker-compose `db` service)
POSTGRES_DB=rynok
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433

# Adminer (docker-compose `db-admin` service) — http://localhost:8080
ADMINER_PORT=8080

# Typesense (docker-compose `search` service)
TYPESENSE_API_KEY=xyz
TYPESENSE_PORT=8108
TYPESENSE_HOST=localhost
TYPESENSE_PROTOCOL=http

# Typesense Dashboard (docker-compose `search-admin` service) — http://localhost:8081
TYPESENSE_DASHBOARD_PORT=8081

# Redis (docker-compose `redis` service)
REDIS_PORT=6379

# Dozzle (docker-compose `dozzle` service) — http://localhost:9999 — live container log viewer
DOZZLE_PORT=9999

# JWT — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=content-owl:
REDIS_DEFAULT_TTL_SECONDS=3600

# Redis Queue — independent connection for BullMQ job queues
REDIS_QUEUE_URL=redis://localhost:6379/1
REDIS_QUEUE_PREFIX=bull:

# Bull Board Dashboard — job queue monitoring UI
ENABLE_BULL_BOARD=false

# CORS — comma-separated list of allowed origins; set explicitly in production (no wildcard)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed Configuration
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-secure-password
SEED_USER_COUNT=10
SEED_USER_PASSWORD=change-me-to-secure-password
SEED_PROPERTY_COUNT=10
